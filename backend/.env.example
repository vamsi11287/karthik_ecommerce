# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_parser_secret

# Razorpay Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Cloudinary (Image Upload)
# Get these from https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Super Admin Initial Bootstrap
SUPER_ADMIN_NAME=Store Owner
SUPER_ADMIN_EMAIL=superadmin@luxwear.com
SUPER_ADMIN_PASSWORD=SuperAdmin@2026!
SUPER_ADMIN_PHONE=+919876543210
